# Copy this file to .env, fill in every required value, then either export the
# values through your process manager or run: velociportal serve --env-file .env
# Values are parsed as data; shell interpolation and command substitution do not run.

# Select exactly one control plane. Headscale is supported; Tailscale SaaS is
# preview. Existing v0.2 Headscale files without this selector still start with a
# deprecation warning, but v0.3 will require an explicit value.
CONTROL_PLANE=headscale

# Headscale base URL without /api/v1, query, or fragment.
# Set the endpoint reachable from this contributor/runtime environment. Production
# uses the exact private Docker alias documented in deploy/velociportal.env.example.
# HTTP is accepted only for the implementation's exact local/internal allowlist;
# every other host requires verified HTTPS. There is no insecure TLS mode.
HEADSCALE_URL=

# Dedicated Velociportal runtime key. Headscale v0.29.3 keys are unscoped
# administrator credentials. Do not reuse the workstation operator key.
HEADSCALE_API_KEY=

# Set the endpoint reachable from this contributor/runtime environment. Production
# uses the exact private Docker alias documented in deploy/velociportal.env.example.
# Plain HTTP is accepted only for that alias or same-host/loopback compatibility;
# every other NPM location requires verified HTTPS.
NPM_URL=

# Dedicated NPM account that can list proxy hosts.
NPM_EMAIL=velociportal@example.com

# NPM account password.
NPM_PASSWORD=

# Address to listen on. Docker Compose overrides this to 0.0.0.0:8080 inside
# the container while publishing the host port on loopback only.
LISTEN_ADDR=127.0.0.1:8080

# How often to poll upstream APIs. Go duration from 5s through 24h.
POLL_INTERVAL=30s

# REQUIRED: exact IP/CIDR of the trusted Tailscale Serve path that injects
# identity headers. In the production host-loopback topology this is normally
# the fixed Compose bridge gateway /32. Observe and verify the real source.
TRUSTED_PROXY_CIDR=
