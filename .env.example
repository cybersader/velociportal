# Copy this file to .env, fill in every required value, then either export the
# values through your process manager or run: velociportal serve --env-file .env
# Values are parsed as data; shell interpolation and command substitution do not run.

# Headscale control server URL (http/https, no query or fragment)
HEADSCALE_URL=

# Headscale API key (generate with: headscale apikeys create)
HEADSCALE_API_KEY=

# Nginx Proxy Manager URL (e.g. http://npm:81)
NPM_URL=

# NPM admin email
NPM_EMAIL=admin@example.com

# NPM admin password
NPM_PASSWORD=

# Address to listen on. Docker Compose overrides this to 0.0.0.0:8080 inside
# the container while publishing the port on host loopback only.
LISTEN_ADDR=127.0.0.1:8080

# How often to poll upstream APIs. Go duration from 5s through 24h.
POLL_INTERVAL=30s

# REQUIRED: exact IP/CIDR of the trusted reverse proxy that injects Tailscale
# identity headers. There is intentionally no fallback; startup fails if this is
# empty. A host proxy reaching a bridged container commonly appears as the Docker
# bridge gateway, not 127.0.0.1. Observe the source and prefer its exact /32.
TRUSTED_PROXY_CIDR=
