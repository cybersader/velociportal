# Copy this file to .env, fill in every required value, then either export the
# values through your process manager or run: velociportal serve --env-file .env
# Values are parsed as data; shell interpolation and command substitution do not run.

# Select exactly one control plane. Headscale is supported; Tailscale SaaS is
# preview. Existing v0.2 Headscale files without this selector still start with a
# deprecation warning, but v0.3 will require an explicit value.
CONTROL_PLANE=headscale

# Headscale base URL without /api/v1, query, or fragment.
# Set the endpoint reachable from this contributor/runtime environment. Production
# uses the exact private Docker alias documented in deploy/velociportal.env.example.
# HTTP is accepted only for the implementation's exact local/internal allowlist;
# every other host requires verified HTTPS. There is no insecure TLS mode.
HEADSCALE_URL=

# Dedicated Velociportal runtime key. Headscale v0.29.3 keys are unscoped
# administrator credentials. Do not reuse the workstation operator key.
HEADSCALE_API_KEY=

# Set the endpoint reachable from this contributor/runtime environment. Production
# uses the exact private Docker alias documented in deploy/velociportal.env.example.
# Plain HTTP is accepted only for that alias or same-host/loopback compatibility;
# every other NPM location requires verified HTTPS.
NPM_URL=

# Dedicated NPM account that can list proxy hosts.
NPM_EMAIL=velociportal@example.com

# NPM account password.
NPM_PASSWORD=

# Address to listen on. Docker Compose overrides this to 0.0.0.0:8080 inside
# the container while publishing the host port on loopback only.
LISTEN_ADDR=127.0.0.1:8080

# How often to poll upstream APIs. Go duration from 5s through 24h.
POLL_INTERVAL=30s

# REQUIRED: exact IP/CIDR of the trusted Tailscale Serve path that injects
# identity headers. In the production host-loopback topology this is normally
# the fixed Compose bridge gateway /32. Observe and verify the real source.
TRUSTED_PROXY_CIDR=

# Optional deployment default for the browser-local "Show Velociportal logo"
# preference: visible (default) or hidden. It only supplies the initial state
# for a browser with no stored preference; the per-identity, per-browser choice
# always wins once set. This preference is never sent to Velociportal.
PORTAL_LOGO_DEFAULT=visible

# UNRELEASED personal tailnet services: Tailscale-only, independent of PORTAL_EDIT_MODE.
# Optional canonical SAME browser-facing portal origin, no path/trailing slash.
# Placeholder only; absent disables, empty/invalid values or Headscale fail config.
# PORTAL_PERSONAL_SERVICES_ORIGIN=http://portal.tailnet.ts.net:8081
# Private to the same exact login across devices, bounded RAM only: restart loses
# server copy. Explicit browser restore may be stale; never automatic. No mount,
# database, extra container or shared editor settings. Use normal launch URLs,
# never pairing links/codes; personal links reject query/fragment/userinfo.

# UNRELEASED mode selector: canonical off | browser | shared (never empty).
# Absent preserves RC.17: shared only when both valid shared settings are supplied.
# Explicit off ignores retained shared settings; normal readonly metadata still loads.
# PORTAL_EDIT_MODE=off
# Browser mode stores only name/link/finite-icon choices per identity and origin
# in this browser, not across devices; clearing site storage removes them.
# No editor allowlist, public origin, file or writable mount is needed. Optional
# readonly SERVICE_METADATA_FILE supplies defaults; blank/reset restores them.
# Browser rejects supplied PORTAL_EDITORS/PORTAL_PUBLIC_ORIGIN, even empty values.
# PORTAL_EDIT_MODE=browser
# Shared mode requires separately provisioned safe runtime-owned directory storage.
# Existing strict v1/v2 files are not migrated until the first explicit v3 save.
# PORTAL_EDIT_MODE=shared
# SERVICE_METADATA_FILE=/absolute/runtime-owned-directory/services.json
# PORTAL_EDITORS='["alice@example.com"]'
# PORTAL_PUBLIC_ORIGIN=http://portal.tailnet.ts.net:8081
# Exact login only; origin has no trailing slash. Do not use the readonly file
# mount for shared editing or alter protected dataset permissions.
