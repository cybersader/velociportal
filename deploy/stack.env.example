# Copy to stack.env beside compose.yaml.
# Replace the release-candidate example with an image tag or digest that has
# actually been published and verified. Never deploy `latest`. The Compose bundle
# uses pull_policy: always; prefer a digest when one is available.
VELOCIPORTAL_IMAGE=ghcr.io/cybersader/velociportal:v0.1.0-rc.1

# The credentialed application env file is resolved on the Docker host.
VELOCIPORTAL_ENV_FILE=./velociportal.env

# Keep these three values consistent. Change them only if this subnet conflicts
# with an existing route, and validate the source address on the real system.
VELOCIPORTAL_SUBNET=172.31.255.0/24
VELOCIPORTAL_GATEWAY=172.31.255.1
VELOCIPORTAL_TRUSTED_PROXY_CIDR=172.31.255.1/32
