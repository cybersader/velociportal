# Copy to stack.env beside compose.yaml.
# Replace the release-candidate example with an image tag or digest that has
# actually been published and verified. Never deploy `latest`. The Compose bundle
# uses pull_policy: always; prefer a digest when one is available.
VELOCIPORTAL_IMAGE=ghcr.io/cybersader/velociportal:v0.1.0-rc.2
# This historical published pin does NOT implement MCP/durable personal/v4.
# RC.18/19 also lack these RC.20 candidate features. Before that opt-in,
# require a future published immutable digest explicitly containing them; do not
# infer feature availability from new comments or substitute a nonexistent tag.

# The credentialed application env file is resolved on the Docker host.
VELOCIPORTAL_ENV_FILE=./velociportal.env

# Keep these three values consistent. Change them only if this subnet conflicts
# with an existing route, and validate the source address on the real system.
VELOCIPORTAL_SUBNET=172.31.255.0/24
VELOCIPORTAL_GATEWAY=172.31.255.1
VELOCIPORTAL_TRUSTED_PROXY_CIDR=172.31.255.1/32

# UNRELEASED private-directory overlay only; disabled unless explicitly included.
# Illustrative host path, not a selected NAS dataset or permission-change command.
# Preprovision only after exact paths/runtime UID:GID/modes/backups/rollback approval.
# VELOCIPORTAL_PERSONAL_SERVICES_DIRECTORY=/absolute/approved/private-directory
# Optional existing shared-editor overlay uses its OWN separate directory:
# VELOCIPORTAL_SERVICE_METADATA_DIRECTORY=/absolute/approved/shared-directory
# MCP origin / personal origin / state namespace belong in the provider env file,
# not this interpolation file. No new mount or container is added to the base.
