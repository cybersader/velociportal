{
  "version": 1,
  "interval": "60s",
  "timeout": "3s",
  "workers": 4,
  "allowed_cidrs": [
    "100.64.0.0/10",
    "192.168.0.0/16"
  ],
  "allowed_hosts": [
    "example-backend"
  ],
  "allowed_dns_suffixes": [
    ".home"
  ],
  "services": [
    {
      "proxy_host_id": 42,
      "type": "http",
      "path": "/health",
      "accepted_statuses": [
        {
          "min": 200,
          "max": 399
        }
      ]
    },
    {
      "proxy_host_id": 43,
      "type": "tcp"
    }
  ]
}
