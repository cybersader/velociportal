# Copy to velociportal.env and restrict it to TrueNAS administrators plus the
# Apps service. Values use Velociportal's go-quoted-v1 encoding.

# Tailscale SaaS support is labeled preview until live acceptance passes.
# Production always uses OAuth client credentials against the fixed verified
# https://api.tailscale.com/api/v2 origin and the credential's "-" tailnet alias.
CONTROL_PLANE="tailscale"
TAILSCALE_OAUTH_CLIENT_ID="replace-with-the-dedicated-oauth-client-id"
TAILSCALE_OAUTH_CLIENT_SECRET="replace-with-the-dedicated-oauth-client-secret"

# NPM remains on the private velociportal-upstreams bridge for service discovery.
NPM_URL="http://npm.velociportal.internal:81"
NPM_EMAIL="velociportal@example.com"
NPM_PASSWORD="replace-with-the-dedicated-npm-password"

POLL_INTERVAL="30s"

# Optional deployment default for the browser-local "Show Velociportal logo"
# preference: visible (default) or hidden. It only supplies the initial state
# when a viewer's browser has no stored preference yet; the per-identity,
# per-browser choice always wins once set and is never sent to Velociportal.
PORTAL_LOGO_DEFAULT="visible"

# UNRELEASED personal tailnet services, independent of PORTAL_EDIT_MODE.
# Optional canonical SAME portal browser origin; placeholder only, no trailing slash.
# Absent disables; explicit empty/invalid origin fails. No mount/database/extra container.
# PORTAL_PERSONAL_SERVICES_ORIGIN="http://portal.tailnet.ts.net:8081"
# Same-exact-login devices read the latest server copy only while the process lives.
# Restart loses RAM; browser recovery is explicit and may be stale, never automatic.
# Use a normal HTTPS ts.net app launch link, never pairing URLs/codes; no query,
# fragment or userinfo. Current device plus positive ingress TCP Grant is required
# for an active card; neither reachability nor application sign-in is guaranteed.

# UNRELEASED PORTAL_EDIT_MODE: canonical off | browser | shared, never empty.
# Absent preserves RC.17 shared-setting inference; off ignores retained shared keys.
# PORTAL_EDIT_MODE="off"
# Browser needs no editor/origin/file/writable mount; optional readonly metadata
# supplies defaults. Preferences are per identity+origin in this browser only;
# clearing site storage removes them, and blank/reset restores current defaults.
# Browser rejects PORTAL_EDITORS/PORTAL_PUBLIC_ORIGIN even when empty.
# PORTAL_EDIT_MODE="browser"
# Shared mode requires both settings below and approved runtime-owned storage.
# PORTAL_EDIT_MODE="shared"
# Use compose.service-editor.yaml INSTEAD OF compose.service-metadata.yaml,
# only with a separately approved runtime-owned directory containing services.json.
# Compose sets SERVICE_METADATA_FILE=/service-metadata/services.json.
# PORTAL_EDITORS="[\"alice@example.com\"]"
# PORTAL_PUBLIC_ORIGIN="http://portal.tailnet.ts.net:8081"
# Exact full logins only; canonical origin, no trailing slash. First explicit
# save upgrades the preserved file to v3; rollback needs compatible metadata.
