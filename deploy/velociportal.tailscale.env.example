# Copy to velociportal.env and restrict it to TrueNAS administrators plus the
# Apps service. Values use Velociportal's go-quoted-v1 encoding.

# Tailscale SaaS support is labeled preview until live acceptance passes.
# Production always uses OAuth client credentials against the fixed verified
# https://api.tailscale.com/api/v2 origin and the credential's "-" tailnet alias.
CONTROL_PLANE="tailscale"
TAILSCALE_OAUTH_CLIENT_ID="replace-with-the-dedicated-oauth-client-id"
TAILSCALE_OAUTH_CLIENT_SECRET="replace-with-the-dedicated-oauth-client-secret"

# NPM remains on the private velociportal-upstreams bridge for service discovery.
NPM_URL="http://npm.velociportal.internal:81"
NPM_EMAIL="velociportal@example.com"
NPM_PASSWORD="replace-with-the-dedicated-npm-password"

POLL_INTERVAL="30s"

# Optional deployment default for the browser-local "Show Velociportal logo"
# preference: visible (default) or hidden. It only supplies the initial state
# when a viewer's browser has no stored preference yet; the per-identity,
# per-browser choice always wins once set and is never sent to Velociportal.
PORTAL_LOGO_DEFAULT="visible"
